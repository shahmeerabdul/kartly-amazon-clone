generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String  @default("US")
  phone     String
  isDefault Boolean @default(false)

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  imageUrl String
  products Product[]
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  brand          String?
  description    String
  bullets        String[]
  priceCents     Int
  listPriceCents Int?
  rating         Float
  ratingCount    Int
  stock          Int
  images         String[]
  thumbnail      String
  specs          Json
  tags           String[]
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  reviews        Review[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]

  @@index([categoryId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  title      String
  body       String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  cart          Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  savedForLater Boolean @default(false)

  @@unique([cartId, productId])
}

enum OrderStatus {
  PLACED
  CANCELLED
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            OrderStatus @default(PLACED)
  subtotalCents     Int
  shippingCents     Int
  taxCents          Int
  totalCents        Int
  shippingAddress   Json
  deliveryOption    String
  estimatedDelivery DateTime
  paymentLast4      String
  createdAt         DateTime    @default(now())
  items             OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title      String
  image      String
  priceCents Int
  quantity   Int

  @@index([orderId])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}
